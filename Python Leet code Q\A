Perfect Number
===============
Example 1:
===============
Input: num = 28
Output: true

Example 2:
=============
Input: num = 7
Output: false
================================================================
class Solution(object):
    def checkPerfectNumber(self, num):
        p=0
        for i in range(1,num):
            if num%i==0:
                p=p+i
        if p==num:
            return True
        else:
            return False
        
